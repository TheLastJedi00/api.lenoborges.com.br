# 1. A URL do seu projeto
SUPABASE_URL="https://seu-id.supabase.co"

# 2. A chave de acesso (Escolha APENAS UMA para colocar no cliente do seu backend)
# Use a SERVICE_ROLE se a sua API precisar de acesso total ignorando RLS
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"
# 4. String de Conexão do Banco de Dados (Caso use ORMs)
DATABASE_URL="postgresql://postgres:""