# API Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"

# Quantidade de proxies na frente da API. Precisa bater com a topologia real:
# um numero maior que a quantidade de proxies permite furar o rate limit por IP
# com um X-Forwarded-For forjado.
TRUST_PROXY_HOPS=1

# Swagger em /docs. Fora de producao ja vem ligado. Em producao ele fica
# desligado (o schema completo sem auth entrega o mapa da API); ligue apenas
# quando houver protecao na frente.
# SWAGGER_ENABLED=true

# Database Connection
DATABASE_URL="postgresql://postgres:password@db.id.supabase.co:5432/postgres"

# TLS do banco. A conexao carrega PII, entao a verificacao do certificado fica
# ligada por padrao. O host direto do Supabase usa CA propria: baixe o arquivo em
# Settings > Database > SSL Configuration e aponte DATABASE_SSL_CA_PATH para ele.
DATABASE_SSL_CA_PATH="./certs/prod-ca.crt"
# Desliga a verificacao. Apenas banco local ou descartavel, nunca em producao.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Supabase Auth (spec 005)
SUPABASE_URL="https://seu-id.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anon"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"

# Verificacao local do JWT. Projeto novo usa JWKS (derivado de SUPABASE_URL);
# projeto legado usa o segredo HS256. Um dos dois precisa existir.
# SUPABASE_JWT_SECRET="segredo-legado-hs256"

# Emissor esperado no JWT. Por padrao o guard usa SUPABASE_URL + /auth/v1, que e
# o que o Supabase hospedado emite. So preencha se o projeto tiver
# GOTRUE_JWT_ISSUER customizado, senao todo token valido sera recusado.
# SUPABASE_JWT_ISSUER="https://seu-id.supabase.co/auth/v1"

# Cookie do refresh token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_DAYS=30