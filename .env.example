# API Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"

# Quantidade de proxies na frente da API. Precisa bater com a topologia real:
# um numero maior que a quantidade de proxies permite furar o rate limit por IP
# com um X-Forwarded-For forjado.
TRUST_PROXY_HOPS=1

# Swagger em /docs. Fora de producao ja vem ligado. Em producao ele fica
# desligado (o schema completo sem auth entrega o mapa da API); ligue apenas
# quando houver protecao na frente.
# SWAGGER_ENABLED=true

# Firebase (spec 007)
#
# Chave de servico do projeto: o conteudo do JSON baixado em Project settings >
# Service accounts, inteiro, em UMA linha so. E credencial de administrador do
# projeto: quem a tem emite token de qualquer usuario e le qualquer documento do
# Firestore, ignorando as security rules. Nunca commitar um valor real aqui.
#
# A chave privada dentro do JSON e um PEM, com quebras de linha escapadas como
# \n. Mantenha as sequencias como estao: o parse em src/config/service-account.ts
# as converte de volta.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"seu-projeto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@seu-projeto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Chave publica do projeto (Project settings > General > Web API Key), usada nas
# chamadas REST ao Identity Toolkit. NAO e segredo: vai no bundle de qualquer app
# Firebase web por desenho. Esta aqui por conveniencia, nao por sigilo.
FIREBASE_WEB_API_KEY="sua-web-api-key"

# Cookie do refresh token.
# AUTH_COOKIE_SECURE aceita apenas "true" ou "false".
# AUTH_COOKIE_SAMESITE aceita apenas "lax", "strict" ou "none".
# Em producao, front e API ficam em dominios distintos e o valor e "none", que
# exige "true" no secure: o navegador descarta cookie SameSite=None sem Secure, e
# a API se recusa a subir com essa combinacao para o problema nao aparecer so
# depois, como sessao que nao persiste.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_DAYS=30
# ---------------------------------------------------------------------------
# E-mail (spec 014)
# ---------------------------------------------------------------------------

# Chave do Resend. SEM ELA O MAILER APENAS LOGA E NAO ENVIA, e esse e o padrao
# fora de producao de proposito: o perigo do desenvolvimento nao e o e-mail que
# nao sai, e o que sai -- uma maquina local apontada para o Firestore de
# producao rodando o gatilho de video manda para a base inteira. Em producao o
# boot exige a chave.
# RESEND_API_KEY="re_..."

# Remetente. DO DOMINIO PROPRIO, nunca o dominio de teste do provedor: e-mail de
# dominio nao autenticado cai em spam, e uma vez que a base aprende que o
# remetente e spam, os envios seguintes ja nascem la. SPF, DKIM e DMARC precisam
# estar no DNS antes do primeiro disparo real.
EMAIL_FROM="Liga Dev <comunidade@lenoborges.com.br>"

# Para onde vai a resposta de quem responder ao e-mail.
EMAIL_REPLY_TO="leno@lenoborges.com.br"

# Se os cabecalhos List-Unsubscribe acompanham o envio. Ausente = LIGADO, e so
# o valor `off` desliga -- um erro de digitacao aqui nao pode virar um envio sem
# cabecalho.
#
# ELE EXISTE PARA UMA MEDICAO, E NAO PARA FICAR DESLIGADO. A suspeita e que
# estes cabecalhos joguem o e-mail na aba Promocoes do Gmail, porque eles sao
# literalmente o que declara a mensagem como correspondencia de lista. Desligar
# permite mandar dos dois jeitos para a mesma caixa e comparar -- que e a unica
# forma de saber.
#
# O preco de deixar desligado: some o botao "Cancelar inscricao" que o Gmail
# desenha no topo da mensagem, e quem quer sair da lista aperta "marcar como
# spam". Isso e pior que a aba Promocoes e nao tem volta para a reputacao do
# dominio. Google e Yahoo exigem os cabecalhos acima de 5.000 mensagens por dia.
#
# O link do rodape NAO depende desta variavel e nunca desaparece.
EMAIL_LIST_UNSUBSCRIBE="on"

# Segredo do HMAC do token de descadastro. TROCAR ESTE VALOR INVALIDA TODO LINK
# DE DESCADASTRO JA ENVIADO -- e link de descadastro morto e pior que qualquer
# risco que ele carrega: quem quer sair e nao consegue aperta "marcar como spam",
# que custa reputacao de dominio.
EMAIL_UNSUBSCRIBE_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Segredo da assinatura do webhook de bounce e reclamacao. Sem ele o webhook
# recusa tudo, e endereco morto nunca se desliga sozinho. Obrigatorio em
# producao.
# RESEND_WEBHOOK_SECRET="whsec_..."

# Onde esta API responde, em ABSOLUTO. E-mail nao tem roteador: o link do rodape
# e o cabecalho List-Unsubscribe precisam da URL inteira, e quem responde ao
# descadastro e este servidor, nao o front. Sem ela o fallback e localhost, que
# funciona em desenvolvimento e produz um link morto em producao -- por isso o
# boot a exige la.
# API_PUBLIC_URL="https://api.lenoborges.com.br"
